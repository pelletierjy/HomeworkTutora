{
  "buildCommand": "node scripts/inject-conversia-env.mjs && npm run build:i18n",
  "outputDirectory": "dist/HomeworkTutora/browser",
  "rewrites": [
    { "source": "/en/:path*", "destination": "/en/index.html" },
    { "source": "/fr/:path*", "destination": "/fr/index.html" },
    { "source": "/es/:path*", "destination": "/es/index.html" }
  ]
}
